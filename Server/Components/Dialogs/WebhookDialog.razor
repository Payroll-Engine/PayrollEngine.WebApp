@implements PayrollEngine.WebApp.Presentation.IItemValidator

@using PayrollEngine.WebApp.ViewModel
@using PayrollEngine.WebApp.Presentation.Component

<MudDialog Class="pe-item-dialog" TitleClass="mud-theme-primary pe-dialog-title">
    <DialogContent>
        <MudForm @ref="form">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
                <MudTabPanel Text="@Localizer.Shared.CommonFields" PanelClass="pa-3">
                    <MudStack Class="pa-4" Spacing="1">
                        <MudTextField T="string" @bind-Value="Webhook.Name"
                                      MaxLength="@SystemSpecification.KeyTextLength"
                                      ReadOnly="@Webhook.IsExistingObject"
                                      Label="@(Webhook.IsNewObject ? $"{Localizer.Shared.Name} ({Localizer.Shared.Immutable})" : Localizer.Shared.Name)"
                                      Validation="@(!string.IsNullOrWhiteSpace(Webhook.Name))"
                                      Required="true" RequiredError="Name is required" />
                        <MudTextField T="string" @bind-Value="Webhook.ReceiverAddress"
                                      MaxLength="@SystemSpecification.KeyTextLength"
                                      Label="@Localizer.Webhook.ReceiverAddress"
                                      Validation="@(!string.IsNullOrWhiteSpace(Webhook.ReceiverAddress))"
                                      Required="true" RequiredError="Receiver address is required" />
                        <MudSelect T="WebhookAction" @bind-Value="Webhook.Action"
                                   Label="@Localizer.Webhook.Action"
                                   Validation="@(!string.IsNullOrWhiteSpace(Webhook.ReceiverAddress))"
                                   Required="true" RequiredError="Receiver is required">
                            <EnumSelectItems T="WebhookAction" />
                        </MudSelect>
                        @* secret: write-only, the backend never returns it (null = keep, empty = remove) *@
                        <MudTextField T="string" @bind-Value="SecretInput"
                                      InputType="@SecretType"
                                      MaxLength="256"
                                      Immediate="true"
                                      Disabled="@removeSecret"
                                      Label="@Localizer.Webhook.Secret"
                                      HelperText="@(Webhook.Signed ? Localizer.Webhook.SecretKeep : null)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@SecretIcon"
                                      OnAdornmentClick="ToggleSecretVisibility"
                                      AdornmentAriaLabel="@Localizer.User.ShowPassword" />
                        @if (Webhook.Signed)
                        {
                            <MudCheckBox T="bool" Value="@removeSecret" ValueChanged="@OnRemoveSecretChanged"
                                         Label="@Localizer.Webhook.SecretRemove" />
                        }
                        <ItemBaseFields Item="Webhook" />
                    </MudStack>
                </MudTabPanel>
                <MudTabPanel Text="@Localizer.Attribute.Attributes" PanelClass="pa-3">
                    <AttributesGrid Item="Webhook" Class="pe-attributes-grid pa-2" />
                </MudTabPanel>
            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <ItemDialogActions Item="Webhook" FormValidator="this" />
    </DialogActions>
</MudDialog>

@code {
    MudForm form;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public Webhook Webhook { get; set; } = new();
    [Inject] private ILocalizerService LocalizerService { get; set; }

    private Localizer Localizer => LocalizerService.Localizer;

    // webhook secret: null keeps the stored secret, empty removes it, any other value replaces it
    private bool removeSecret;
    private string secretInput;

    private string SecretInput
    {
        get => secretInput;
        set
        {
            secretInput = value;
            Webhook.Secret = !string.IsNullOrEmpty(value) ? value : null;
        }
    }

    // show/hide the secret while typing
    private InputType SecretType { get; set; } = InputType.Password;
    private string SecretIcon { get; set; } = Icons.Material.Filled.VisibilityOff;

    private void ToggleSecretVisibility()
    {
        if (SecretType == InputType.Text)
        {
            SecretType = InputType.Password;
            SecretIcon = Icons.Material.Filled.VisibilityOff;
        }
        else
        {
            SecretType = InputType.Text;
            SecretIcon = Icons.Material.Filled.Visibility;
        }
    }

    private void OnRemoveSecretChanged(bool remove)
    {
        removeSecret = remove;
        secretInput = null;
        Webhook.Secret = remove ? string.Empty : null;
    }

    public async Task<bool> ValidateAsync() =>
        await form.Revalidate();
}